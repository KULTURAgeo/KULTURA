# Required settings. No NEXT_PUBLIC variables are needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
ENABLE_EXPERIMENTAL_COREPACK=1

# Stripe TEST MODE checkout only. Never put these in NEXT_PUBLIC variables.
STRIPE_SECRET_KEY=
# Add after deploying /api/stripe/webhook and creating a Stripe test webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Server-only Supabase key used only for trusted order writes and webhook reconciliation.
SUPABASE_SERVICE_ROLE_KEY=
