# Required settings. No NEXT_PUBLIC variables are needed.
# The server validates and passes ONLY the public URL/publishable key to the browser.
# Use the project URL and publishable (or legacy anon) key from Supabase.
# NEVER use service_role or an sb_secret_ key as SUPABASE_PUBLISHABLE_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only, required when Resend/Twilio delivery is configured. Never NEXT_PUBLIC.
# Prefer a dedicated Supabase secret key for notification delivery.
SUPABASE_SECRET_KEY=
# Required for Production/Preview writes. Use a separate Redis database for staging.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate at least 32 random bytes, e.g. node crypto.randomBytes(32).toString('hex').
RATE_LIMIT_HMAC_KEY=
# Local/staging administrators only; also requires the private DB setting.
# Never enable on production or on staging connected to the production database.
ENABLE_TEST_CHECKOUT=false
# Local origin; replace with your exact HTTPS domain in Vercel Production.
# Set a separate fixed staging origin for Vercel Preview deployments.
SITE_URL=http://localhost:3000
# Optional Google Search Console HTML-tag verification token.
# Add only the token value, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=
# Optional analytics identifiers. These IDs are public identifiers, not secrets.
# GA4 Measurement ID format: G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=
# Meta Pixel numeric ID
META_PIXEL_ID=
# Transactional order email via Resend. Leave blank to keep email notifications queued.
RESEND_API_KEY=
# Example: KULTURA <orders@yourdomain.ge>. The sending domain must be verified in Resend.
NOTIFICATION_EMAIL_FROM=
# Transactional SMS via Twilio. Leave blank to keep SMS notifications queued.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a Twilio sender/number OR a Messaging Service SID.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Keep false until real content, policies, services and launch checks are complete.
# Preview deployments always remain noindex even when this is true.
SITE_INDEXABLE=false
# VERCEL and VERCEL_ENV are supplied by Vercel; do not configure them yourself.
# SMTP credentials belong in Supabase Auth settings, not this application's env.
# Vercel build setting: honors the pinned pnpm version in package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
# QA_BASE_URL and PLAYWRIGHT_MODULE are optional local test settings only.
